# Copy to .env next to compose.yaml.
# Bearer token clients send; generate with: openssl rand -hex 32
REBOX_TOKEN=
# The directory with your targets, mounted at the same absolute path in the container.
# No path element may start with "." (Ghidra refuses such project paths).
RE_WORKDIR=/home/you/re
# Owner of files the container writes into RE_WORKDIR (id -u / id -g on the host).
PUID=1000
PGID=1000
# REBOX_IMAGE=registry.example/re-box:<tag>
