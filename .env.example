# Copy to .env next to compose.yaml. The token goes in ./rebox_token, not here:
#   openssl rand -hex 32 > rebox_token && chmod 600 rebox_token
# The directory with your targets, mounted at the same absolute path in the container.
RE_WORKDIR=/home/you/re
# Optional: keep re-box's state (Ghidra project, settings, caches, REA evidence) elsewhere, e.g.
# an agent's scratchpad, and uncomment its volume line in compose.yaml. Default:
# $RE_WORKDIR/re-box-state. No path element may start with "." (Ghidra refuses such project paths).
# REBOX_STATE_DIR=/home/you/re-box-state
# Owner of files the container writes (id -u / id -g on the host).
PUID=1000
PGID=1000
# REBOX_IMAGE=ghcr.io/lhns/re-box:<tag>
