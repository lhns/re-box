@@ -0,0 +1,69 @@
+package com.xebyte.offline;
+
+import com.xebyte.core.SecurityConfig;
+import org.junit.Test;
+
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * {@code GHIDRA_MCP_FILE_ROOT} takes several roots, separated by the platform path
+ * separator. The singleton reads the environment once, so the parsing and the containment
+ * rule are tested through their static helpers, which {@code resolveWithinFileRoot} calls.
+ */
+public class SecurityConfigFileRootsTest {
+
+    @Test
+    public void rootsAreSplitOnThePathSeparatorAndBlanksAreSkipped() throws Exception {
+        Path a = Files.createTempDirectory("root-a");
+        Path b = Files.createTempDirectory("root-b");
+        String raw = a + File.pathSeparator + " " + File.pathSeparator + b + File.pathSeparator;
+
+        List<Path> roots = SecurityConfig.canonicalRoots(raw);
+
+        assertEquals(List.of(a.toRealPath(), b.toRealPath()), roots);
+        assertTrue(SecurityConfig.canonicalRoots(null).isEmpty());
+        assertTrue(SecurityConfig.canonicalRoots("").isEmpty());
+        assertTrue(SecurityConfig.canonicalRoots(File.pathSeparator).isEmpty());
+    }
+
+    @Test
+    public void aPathMustLieUnderOneOfTheRoots() throws Exception {
+        Path a = Files.createTempDirectory("root-a").toRealPath();
+        Path b = Files.createTempDirectory("root-b").toRealPath();
+        List<Path> roots = SecurityConfig.canonicalRoots(a + File.pathSeparator + b);
+
+        assertTrue(SecurityConfig.underAny(a.resolve("x/fw.bin"), roots));
+        assertTrue(SecurityConfig.underAny(b.resolve("target.bin"), roots));
+        assertTrue("a root itself is allowed", SecurityConfig.underAny(a, roots));
+        assertFalse(SecurityConfig.underAny(a.getParent().resolve("elsewhere"), roots));
+        assertFalse("no roots, nothing matches", SecurityConfig.underAny(a, List.of()));
+    }
+
+    @Test
+    public void aSiblingWithTheSamePrefixIsNotUnderTheRoot() throws Exception {
+        Path parent = Files.createTempDirectory("roots");
+        Path work = Files.createDirectory(parent.resolve("work")).toRealPath();
+        Path workshop = Files.createDirectory(parent.resolve("workshop")).toRealPath();
+        List<Path> roots = SecurityConfig.canonicalRoots(work.toString());
+
+        assertFalse(SecurityConfig.underAny(workshop.resolve("a"), roots));
+    }
+
+    @Test
+    public void aRootWrittenWithDotDotIsTheRealDirectory() throws Exception {
+        Path parent = Files.createTempDirectory("roots");
+        Path work = Files.createDirectory(parent.resolve("work")).toRealPath();
+        Files.createDirectory(parent.resolve("secret"));
+        // canonicalRoots canonicalizes its entries, so a root written with ".." is the real directory
+        List<Path> roots = SecurityConfig.canonicalRoots(work + "/../work");
+
+        assertEquals(List.of(work), roots);
+    }
+}
