+        Path requested = canonical(userPath);
+        if (fileRootsCanonical.isEmpty()) {
+            return requested;  // no allow-list configured
+        }
+        return underAny(requested, fileRootsCanonical) ? requested : null;
+    }
+
+    /**
+     * Canonical forms of a list separated by {@link File#pathSeparator}; blank entries are
+     * skipped, so an unset or empty value yields an empty list.
+     */
+    public static List<Path> canonicalRoots(String raw) {
+        List<Path> roots = new ArrayList<>();
+        if (raw != null) {
+            for (String part : raw.split(java.util.regex.Pattern.quote(File.pathSeparator))) {
+                if (!part.isBlank()) {
+                    roots.add(canonical(part.trim()));
+                }
+            }
+        }
+        return List.copyOf(roots);
+    }
+
+    /** Whether {@code path} lies under one of {@code roots} (whole path components, so /workshop is not under /work). */
+    public static boolean underAny(Path path, List<Path> roots) {
+        for (Path root : roots) {
+            if (path.startsWith(root)) return true;
+        }
+        return false;
+    }
+
