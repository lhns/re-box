--- a/.env.template
+++ b/.env.template
@@ -70,6 +70,7 @@ GHIDRA_MCP_ALLOW_SCRIPTS=
 # Confine filesystem-path endpoints (import_file, import_program, export_program,
 # archive_project, restore_project) to a directory.
 # Paths are canonicalized and must resolve under this root. Unset = accept any.
+# Several roots: separate them with the platform path separator (":" on Linux/macOS, ";" on Windows).
 GHIDRA_MCP_FILE_ROOT=
 # Confine project-domain endpoints (open/delete/create) to a project folder
 # prefix, e.g. /MyFolder/Subfolder. Unset = whole project in scope.
