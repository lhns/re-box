+    /** Two clients import the same new file at once: one program, not "<name>" and "<name>.0". */
+    @Test
+    public void concurrentImportsOfOneNewFileMakeOneProgram() throws Exception {
+        File f = file("fw.bin", bytes(32, 9));
+        ExecutorService pool = Executors.newFixedThreadPool(4);
+        try {
+            List<Callable<Response>> calls = new ArrayList<>();
+            for (int i = 0; i < 4; i++) {
+                calls.add(() -> importPlain(f));
+            }
+            int fresh = 0;
+            for (Future<Response> done : pool.invokeAll(calls)) {
+                if (Boolean.FALSE.equals(ok(done.get()).get("reused_existing"))) {
+                    fresh++;
+                }
+            }
+            assertEquals("exactly one call imports; the others reuse its program", 1, fresh);
+        } finally {
+            pool.shutdownNow();
+        }
+
+        List<String> names = new ArrayList<>();
+        for (DomainFile df : provider.getProject().getProjectData().getRootFolder().getFiles()) {
+            names.add(df.getName());
+        }
+        assertEquals(List.of("fw.bin"), names);
+    }
