diff --git a/src/main/java/com/xebyte/core/ImportRequest.java b/src/main/java/com/xebyte/core/ImportRequest.java
new file mode 100644
index 0000000..fd59588
--- /dev/null
+++ b/src/main/java/com/xebyte/core/ImportRequest.java
@@ -0,0 +1,82 @@
+package com.xebyte.core;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * What {@code /import_file} imports and how: the loader options AnalyzeHeadless takes
+ * ({@code -loader}, {@code -loader-<name>}, {@code -processor}, {@code -cspec}) and the name
+ * of the new program.
+ *
+ * @param file           the file to import
+ * @param folder         project folder as the caller wrote it; "/" when blank (resolved and
+ *                       scope-checked by {@link ProjectPaths} when the import runs)
+ * @param programName    name of the new program; the file name when blank
+ * @param loader         "" = auto-detect, or BinaryLoader when a language is given (the
+ *                       endpoint's original behaviour); "auto" = auto-detect with language and
+ *                       compiler spec as hints; otherwise a loader class name (BinaryLoader,
+ *                       MzLoader, ElfLoader, ...)
+ * @param loaderArgs     loader options by name, with or without the "-loader-" prefix
+ *                       (BinaryLoader's base address is "baseAddr")
+ * @param languageId     language ID or ""
+ * @param compilerSpecId compiler spec ID or ""
+ * @param ifExists       what to do when the folder already holds a program of that name:
+ *                       "reuse" it when it was imported from the same bytes (else refuse),
+ *                       "error", or import under a "unique" name
+ */
+public record ImportRequest(File file, String folder, String programName, String loader,
+        Map<String, String> loaderArgs, String languageId, String compilerSpecId,
+        String ifExists) {
+
+    public static final String REUSE = "reuse";
+    public static final String ERROR = "error";
+    public static final String UNIQUE = "unique";
+
+    public ImportRequest {
+        folder = folder == null || folder.isBlank() ? "/" : folder.trim();
+        programName = programName == null || programName.isBlank() ? file.getName() : programName.trim();
+        loader = loader == null ? "" : loader.trim();
+        loaderArgs = loaderArgs == null ? Map.of() : normalizeLoaderArgs(loaderArgs);
+        languageId = languageId == null ? "" : languageId.trim();
+        compilerSpecId = compilerSpecId == null ? "" : compilerSpecId.trim();
+        ifExists = ifExists == null || ifExists.isBlank() ? REUSE : ifExists.trim().toLowerCase(Locale.ROOT);
+        if (!List.of(REUSE, ERROR, UNIQUE).contains(ifExists)) {
+            throw new Refusal("if_exists must be reuse, error or unique");
+        }
+        if (programName.contains("/")) {
+            throw new Refusal("program_name must not contain '/'");
+        }
+    }
+
+    /** The original four-argument import: auto-detect, or BinaryLoader with a language. */
+    public static ImportRequest basic(File file, String folder, String languageId, String compilerSpecId) {
+        return new ImportRequest(file, folder, null, "", null, languageId, compilerSpecId, REUSE);
+    }
+
+    /**
+     * Keys as AnalyzeHeadless passes them to the loader ("-loader-&lt;name&gt;"); values as
+     * text, so a JSON number or boolean works as well as a string.
+     */
+    public static Map<String, String> normalizeLoaderArgs(Map<String, ?> raw) {
+        Map<String, String> out = new LinkedHashMap<>();
+        for (Map.Entry<String, ?> e : raw.entrySet()) {
+            String key = e.getKey() == null ? "" : e.getKey().trim();
+            if (key.isEmpty()) {
+                throw new Refusal("loader_args has an empty name");
+            }
+            out.put(key.startsWith("-loader-") ? key : "-loader-" + key,
+                e.getValue() == null ? "" : String.valueOf(e.getValue()));
+        }
+        return out;
+    }
+
+    List<generic.stl.Pair<String, String>> loaderArgPairs() {
+        List<generic.stl.Pair<String, String>> pairs = new ArrayList<>();
+        loaderArgs.forEach((k, v) -> pairs.add(new generic.stl.Pair<>(k, v)));
+        return pairs;
+    }
+}
