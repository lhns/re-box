+            }
+            if (waitForAnalysis) {
+                out.put("auto_analyzed", analyzeImported(program, autoAnalyze));
+            } else {
+                importFailures.remove(path);
+                pendingImports.add(path);
+                Thread worker = new Thread(() -> {
+                    try {
+                        if (!analyzeImported(program, autoAnalyze) && autoAnalyze) {
+                            importFailures.put(path, "auto-analysis did not complete; see the server log");
+                        }
+                    } catch (Exception e) {
+                        importFailures.put(path, e.getMessage() != null ? e.getMessage() : e.toString());
+                        Msg.error(this, "Background import of " + path + " failed", e);
+                    } finally {
+                        pendingImports.remove(path);
+                    }
+                }, "import-" + program.getName());
+                worker.setDaemon(true);
+                worker.start();
+                out.put("analyzing", true);
+            }
+        }
+        out.put("function_count", program.getFunctionManager().getFunctionCount());
+        String shown = showInWorkbench(program);
+        if (shown != null) {
+            out.put("codebrowser", shown);
+        }
