+    /**
+     * Set analyzer options by name before the first analysis. An unknown name, a value that
+     * does not parse, or an option type import cannot set is refused and nothing is changed.
+     */
+    private void applyAnalysisOptions(Program program, Map<String, String> requested) throws Exception {
+        AutoAnalysisManager.getAnalysisManager(program).initializeOptions();
+        threadingStrategy.executeWrite(program, "Import analysis options", () -> {
+            Options options = program.getOptions(Program.ANALYSIS_PROPERTIES);
+            for (Map.Entry<String, String> e : requested.entrySet()) {
+                String name = e.getKey();
+                String value = e.getValue();
+                if (!options.contains(name)) {
+                    throw new Refusal("Unknown analysis option: " + name);
+                }
+                OptionType type = options.getType(name);
+                try {
+                    switch (type) {
+                        case BOOLEAN_TYPE -> options.setBoolean(name, parseBoolean(name, value));
+                        case INT_TYPE -> options.setInt(name, Integer.parseInt(value.trim()));
+                        case LONG_TYPE -> options.setLong(name, Long.parseLong(value.trim()));
+                        case DOUBLE_TYPE -> options.setDouble(name, Double.parseDouble(value.trim()));
+                        case STRING_TYPE -> options.setString(name, value);
+                        default -> throw new Refusal("Analysis option " + name + " has type " + type
+                            + ", which import cannot set");
+                    }
+                } catch (NumberFormatException bad) {
+                    throw new Refusal("Analysis option " + name + " is " + type + "; '" + value
+                        + "' is not a value of that type");
+                }
+            }
+            return null;
+        });
+    }
+
+    private static boolean parseBoolean(String name, String value) {
+        if ("true".equalsIgnoreCase(value.trim())) {
+            return true;
+        }
+        if ("false".equalsIgnoreCase(value.trim())) {
+            return false;
+        }
+        throw new Refusal("Analysis option " + name + " is a boolean; '" + value + "' is not true or false");
+    }
