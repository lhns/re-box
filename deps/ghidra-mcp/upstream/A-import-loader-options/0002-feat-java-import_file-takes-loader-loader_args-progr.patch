+package com.xebyte.offline;
+
+import com.xebyte.core.ImportRequest;
+import com.xebyte.core.Refusal;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+/** What {@code /import_file} accepts: defaults, loader option names, and the refusals. */
+public class ImportRequestTest {
+
+    @Test
+    public void loaderArgsGetTheHeadlessPrefixOnce() {
+        Map<String, Object> raw = new LinkedHashMap<>();
+        raw.put("baseAddr", "1000:0100");
+        raw.put("-loader-applyLabels", true);
+        raw.put("blockName", 7);
+        assertEquals(
+            Map.of("-loader-baseAddr", "1000:0100", "-loader-applyLabels", "true",
+                "-loader-blockName", "7"),
+            ImportRequest.normalizeLoaderArgs(raw));
+    }
+
+    @Test
+    public void aLoaderArgWithoutANameIsRefused() {
+        assertThrows(Refusal.class, () -> ImportRequest.normalizeLoaderArgs(Map.of(" ", "1")));
+    }
+
+    @Test
+    public void blankFieldsTakeTheirDefaults() {
+        ImportRequest r = new ImportRequest(new File("/w/fw.bin"), " ", null, null, null, null, null, null);
+        assertEquals("/", r.folder());
+        assertEquals("fw.bin", r.programName());
+        assertEquals("", r.loader());
+        assertTrue(r.loaderArgs().isEmpty());
+        assertEquals(ImportRequest.REUSE, r.ifExists());
+    }
+
+    @Test
+    public void theFourArgumentImportKeepsItsMeaning() {
+        ImportRequest r = ImportRequest.basic(new File("/w/fw.bin"), "/fw", "ARM:LE:32:Cortex", "default");
+        assertEquals("", r.loader());  // the provider turns a bare language into BinaryLoader
+        assertEquals("ARM:LE:32:Cortex", r.languageId());
+        assertEquals("default", r.compilerSpecId());
+        assertEquals(ImportRequest.REUSE, r.ifExists());
+    }
+
+    @Test
+    public void ifExistsIsCaseInsensitiveAndOneOfThree() {
+        assertEquals(ImportRequest.UNIQUE,
+            new ImportRequest(new File("/w/x"), "/", null, "", null, "", "", " Unique ").ifExists());
+        Refusal bad = assertThrows(Refusal.class, () ->
+            new ImportRequest(new File("/w/x"), "/", null, "", null, "", "", "replace"));
+        assertEquals("if_exists must be reuse, error or unique", bad.getMessage());
+    }
+
+    @Test
+    public void aProgramNameIsOneProjectFileNotAPath() {
+        assertThrows(Refusal.class, () ->
+            new ImportRequest(new File("/w/x"), "/", "a/b", "", null, "", "", null));
+    }
+}
