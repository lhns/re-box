+        File f = file("fw.bin", bytes(256, 0x90));
+
+        Map<String, Object> out = ok(service.importFile(f.getPath(), "/", X86_REAL, "", true, "", null, "",
+            null, "reuse", false));
+
+        assertEquals(true, out.get("analyzing"));
+        long deadline = System.currentTimeMillis() + 60_000;
+        Map<String, Object> status;
+        do {
+            Thread.sleep(100);
+            status = ok(service.analysisStatus("/fw.bin"));
+        } while (Boolean.TRUE.equals(status.get("analyzing")) && System.currentTimeMillis() < deadline);
+        assertEquals(false, status.get("analyzing"));
