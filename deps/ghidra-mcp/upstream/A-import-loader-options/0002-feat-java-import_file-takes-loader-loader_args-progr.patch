+    private void discardImport(ProjectProgramProvider provider, Program program, Exception cause) {
+        ghidra.framework.model.DomainFile df = program.getDomainFile();
+        try {
+            provider.closeProgramByPath(df.getPathname());
+            df.delete();
+        } catch (Exception e) {
