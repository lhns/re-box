new file mode 100644
index 0000000..79cbc56
--- /dev/null
+++ b/src/test/java/com/xebyte/core/ImportScriptsTest.java
@@ -0,0 +1,114 @@
+package com.xebyte.core;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.Assert.*;
+
+/**
+ * What {@code /import_file} lets an import script be: the shape of the request, the
+ * {@code GHIDRA_MCP_ALLOW_SCRIPTS} gate and {@code GHIDRA_MCP_IMPORT_SCRIPT_ROOTS}. No Ghidra
+ * application is needed; running the scripts is covered by {@code ImportScriptsGhidraTest}.
+ */
+public class ImportScriptsTest {
+
+    private boolean scriptsWereAllowed;
+
+    @Before
+    public void remember() {
+        scriptsWereAllowed = SecurityConfig.getInstance().areScriptsAllowed();
+    }
+
+    @After
+    public void restore() {
+        SecurityConfig.getInstance().setScriptsAllowedForTest(scriptsWereAllowed);
+        SecurityConfig.getInstance().setImportScriptRootsForTest(List.of());
+    }
+
+    private static Path script(Path dir, String name) throws Exception {
+        Files.createDirectories(dir);
+        return Files.writeString(dir.resolve(name), "// not compiled by this test\n").toRealPath();
+    }
+
+    @Test
+    public void scriptListsParseWithArgsKeptWhole() {
+        List<ImportScripts.Call> calls = ImportScripts.parse(List.of(
+            Map.of("path", "/s/Prepare.java", "args", List.of("x86:LE:16:Real Mode", "1000:0100")),
+            Map.of("path", "/s/Fix.java", "args", "one string"),
+            Map.of("path", "/s/Plain.java")), "pre_scripts");
+
+        assertEquals(3, calls.size());
+        assertEquals(List.of("x86:LE:16:Real Mode", "1000:0100"), calls.get(0).args());
+        assertEquals(List.of("one string"), calls.get(1).args());
+        assertEquals(List.of(), calls.get(2).args());
+        assertEquals(List.of(), ImportScripts.parse(null, "pre_scripts"));
+    }
+
+    @Test
+    public void malformedScriptListsAreRefusedByName() {
+        Refusal notAList = assertThrows(Refusal.class, () -> ImportScripts.parse("x", "pre_scripts"));
+        assertEquals("pre_scripts must be a list of {path, args}", notAList.getMessage());
+        Refusal noPath = assertThrows(Refusal.class, () ->
+            ImportScripts.parse(List.of(Map.of("args", List.of())), "post_scripts"));
+        assertEquals("post_scripts entries need a path", noPath.getMessage());
+        assertThrows(Refusal.class, () -> new ImportScripts.Call(" ", List.of()));
+    }
+
+    @Test
+    public void scriptsAreRefusedUnlessTheServerOptedIn() throws Exception {
+        Path s = script(Files.createTempDirectory("scripts"), "Prepare.java");
+        List<ImportScripts.Call> calls = List.of(new ImportScripts.Call(s.toString(), List.of()));
+
+        SecurityConfig.getInstance().setScriptsAllowedForTest(false);
+        Refusal refused = assertThrows(Refusal.class, () -> ImportScripts.check(calls));
+        assertTrue(refused.getMessage(), refused.getMessage().contains("GHIDRA_MCP_ALLOW_SCRIPTS"));
+
+        SecurityConfig.getInstance().setScriptsAllowedForTest(true);
+        ImportScripts.check(calls);  // allowed, and no roots configured
+        ImportScripts.check(List.of());  // nothing to run is never refused
+    }
+
+    @Test
+    public void onlyAbsolutePathsToJavaFilesPass() throws Exception {
+        SecurityConfig.getInstance().setScriptsAllowedForTest(true);
+        Path dir = Files.createTempDirectory("scripts");
+        script(dir, "Notes.txt");
+
+        for (String bad : List.of("Relative.java", dir.resolve("Missing.java").toString(),
+                dir.resolve("Notes.txt").toString(), dir.toString())) {
+            Refusal r = assertThrows(bad, Refusal.class, () ->
+                ImportScripts.check(List.of(new ImportScripts.Call(bad, List.of()))));
+            assertTrue(r.getMessage(), r.getMessage().contains("absolute path to a .java file"));
+        }
+    }
+
+    @Test
+    public void withRootsAScriptMustLieUnderOneOfThem() throws Exception {
+        SecurityConfig.getInstance().setScriptsAllowedForTest(true);
+        Path base = Files.createTempDirectory("roots");
+        Path vetted = Files.createDirectories(base.resolve("vetted")).toRealPath();
+        Path other = Files.createDirectories(base.resolve("vetted-not")).toRealPath();
+        SecurityConfig.getInstance().setImportScriptRootsForTest(List.of(vetted));
+
+        ImportScripts.check(List.of(new ImportScripts.Call(script(vetted.resolve("sub"), "A.java").toString(), List.of())));
+        Refusal outside = assertThrows(Refusal.class, () -> ImportScripts.check(
+            List.of(new ImportScripts.Call(script(other, "B.java").toString(), List.of()))));
+        assertTrue(outside.getMessage(), outside.getMessage().contains("GHIDRA_MCP_IMPORT_SCRIPT_ROOTS"));
+
+        // a symlink inside the root to a script outside it is judged by where it really is
+        Path link = vetted.resolve("Link.java");
+        try {
+            Files.createSymbolicLink(link, other.resolve("B.java"));
+        } catch (UnsupportedOperationException | java.io.IOException noSymlinks) {
+            return;
+        }
+        assertThrows(Refusal.class, () ->
+            ImportScripts.check(List.of(new ImportScripts.Call(link.toString(), List.of()))));
+    }
+}
