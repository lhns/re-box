diff --git a/src/main/java/com/xebyte/core/ImportScripts.java b/src/main/java/com/xebyte/core/ImportScripts.java
new file mode 100644
index 0000000..7b7c9cb
--- /dev/null
+++ b/src/main/java/com/xebyte/core/ImportScripts.java
@@ -0,0 +1,141 @@
+package com.xebyte.core;
+
+import generic.jar.ResourceFile;
+import ghidra.app.script.GhidraScript;
+import ghidra.app.script.GhidraScriptProvider;
+import ghidra.app.script.GhidraScriptUtil;
+import ghidra.app.script.GhidraState;
+import ghidra.app.script.ScriptControls;
+import ghidra.framework.model.Project;
+import ghidra.program.model.listing.Program;
+import ghidra.program.util.ProgramLocation;
+import ghidra.util.task.TaskMonitor;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Scripts that run as part of an import, as AnalyzeHeadless's {@code -preScript} and
+ * {@code -postScript} do: on the loaded program before its first save and analysis, or after
+ * analysis.
+ *
+ * <p>Each script's directory is enabled as its own OSGi source bundle (a directory may ship
+ * its own bundle activator), not copied into {@code ~/ghidra_scripts} the way
+ * {@code /run_ghidra_script} does it, where a copy could replace a script of the same name.
+ * Loading is serialized through {@link #LOAD_LOCK}: Ghidra guards bundle builds with a file
+ * lock meant for separate JVMs, so two threads of one JVM building at once fail with
+ * {@code OverlappingFileLockException}.
+ *
+ * <p>Gated by {@code GHIDRA_MCP_ALLOW_SCRIPTS}, like every other way to run a script; with
+ * {@code GHIDRA_MCP_IMPORT_SCRIPT_ROOTS} set, a script must also lie under one of those
+ * directories.
+ */
+public final class ImportScripts {
+
+    /** Held while a script bundle is built and its class loaded; see the class comment. */
+    public static final Object LOAD_LOCK = new Object();
+
+    /** One script and its arguments; arguments are passed as given, never split. */
+    public record Call(String path, List<String> args) {
+        public Call {
+            if (path == null || path.isBlank()) {
+                throw new Refusal("a script needs a path");
+            }
+            args = args == null ? List.of() : List.copyOf(args);
+        }
+    }
+
+    private ImportScripts() {}
+
+    /**
+     * Parse {@code [{"path": "...", "args": ["...", ...]}, ...]} as the endpoint receives it
+     * (a list of maps; args may also be one string, taken as a single argument).
+     */
+    public static List<Call> parse(Object raw, String what) {
+        if (raw == null) {
+            return List.of();
+        }
+        if (!(raw instanceof List<?> list)) {
+            throw new Refusal(what + " must be a list of {path, args}");
+        }
+        List<Call> calls = new ArrayList<>();
+        for (Object item : list) {
+            if (!(item instanceof Map<?, ?> map) || map.get("path") == null) {
+                throw new Refusal(what + " entries need a path");
+            }
+            Object rawArgs = map.get("args");
+            List<String> args = new ArrayList<>();
+            if (rawArgs instanceof List<?> argList) {
+                for (Object a : argList) {
+                    args.add(String.valueOf(a));
+                }
+            } else if (rawArgs != null) {
+                args.add(String.valueOf(rawArgs));
+            }
+            calls.add(new Call(String.valueOf(map.get("path")), args));
+        }
+        return calls;
+    }
+
+    /** Refuse scripts when they are not allowed, or lie outside the configured roots. */
+    public static void check(List<Call> calls) throws IOException {
+        if (calls.isEmpty()) {
+            return;
+        }
+        SecurityConfig security = SecurityConfig.getInstance();
+        if (!security.areScriptsAllowed()) {
+            throw new Refusal("Import scripts need GHIDRA_MCP_ALLOW_SCRIPTS=1 on the server");
+        }
+        for (Call call : calls) {
+            File file = new File(call.path());
+            if (!file.isAbsolute() || !file.isFile() || !file.getName().endsWith(".java")) {
+                throw new Refusal("Import script is not an absolute path to a .java file: " + call.path());
+            }
+            Path canonical = file.getCanonicalFile().toPath();
+            if (!security.isImportScriptAllowed(canonical)) {
+                throw new Refusal("Import script is outside GHIDRA_MCP_IMPORT_SCRIPT_ROOTS: " + call.path());
+            }
+        }
+    }
+
+    /** Run each script on {@code program}, in order; the first failure stops the run. */
+    public static void run(List<Call> calls, Program program, Project project, PrintWriter out,
+            TaskMonitor monitor) throws Exception {
+        for (Call call : calls) {
+            monitor.checkCancelled();
+            GhidraScript script = load(new File(call.path()), out);
+            script.setScriptArgs(call.args().toArray(String[]::new));
+            ProgramLocation where = program.getMinAddress() == null ? null
+                : new ProgramLocation(program, program.getMinAddress());
+            out.println("--- " + new File(call.path()).getName() + " " + call.args());
+            script.execute(new GhidraState(null, project, program, where, null, null),
+                new ScriptControls(out, out, monitor));
+        }
+    }
+
+    /** A fresh instance of the script at {@code file}, its directory enabled as a bundle. */
+    public static GhidraScript load(File file, PrintWriter out) throws Exception {
+        ResourceFile source = new ResourceFile(file.getCanonicalFile());
+        synchronized (LOAD_LOCK) {
+            if (GhidraScriptUtil.getBundleHost() == null) {
+                // Headless: no script manager plugin owns the bundle host.
+                GhidraScriptUtil.acquireBundleHostReference();
+            }
+            GhidraScriptUtil.getBundleHost().enable(source.getParentFile());
+            GhidraScriptProvider provider = GhidraScriptUtil.getProvider(source);
+            if (provider == null) {
+                throw new IOException("No script provider for " + file);
+            }
+            GhidraScript script = provider.getScriptInstance(source, out);
+            if (script == null) {
+                throw new IOException("Could not load " + file);
+            }
+            return script;
+        }
+    }
+}
