+        ExecutorService pool = Executors.newFixedThreadPool(threads);
+        try {
+            List<Callable<Response>> runs = new ArrayList<>();
+            for (Path s : scripts) {
+                runs.add(() -> service.runGhidraScript(s.toString(), "a b", program, 120));
+            }
+            for (Future<Response> done : pool.invokeAll(runs)) {
+                Map<String, Object> out = ok(done.get());
+                assertEquals(String.valueOf(out), true, out.get("success"));
+                assertTrue(String.valueOf(out), String.valueOf(out.get("console_output")).contains("with 2 args"));
+            }
+        } finally {
+            pool.shutdownNow();
+        }
+    }
+
+    /**
+     * Ghidra guards a bundle build with a file lock meant for separate JVMs: two threads of
+     * one JVM building scripts at the same time fail with OverlappingFileLockException.
+     */
+    @Test
+    public void scriptsLoadingAtTheSameTimeDoNotCollide() throws Exception {
+        int threads = 4;
+        List<Path> scripts = new ArrayList<>();
+        for (int i = 0; i < threads; i++) {
+            scripts.add(script("dir" + i, "FinishImport", POST_SCRIPT));
+        }
+        ExecutorService pool = Executors.newFixedThreadPool(threads);
+        try {
+            List<Callable<Object>> loads = new ArrayList<>();
+            for (Path s : scripts) {
+                loads.add(() -> ImportScripts.load(s.toFile(), new PrintWriter(new StringWriter())));
+            }
+            for (Future<Object> done : pool.invokeAll(loads)) {
+                assertNotNull(done.get());
+            }
+        } finally {
+            pool.shutdownNow();
+        }
+    }
+}
