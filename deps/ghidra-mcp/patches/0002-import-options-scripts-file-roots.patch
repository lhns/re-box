+    /** Set analyzer options by name; an unknown name or an unsupported option type is refused. */
+    private void applyAnalysisOptions(Program program, Map<String, ?> requested) throws Exception {
+        AutoAnalysisManager.getAnalysisManager(program).initializeOptions();
+        threadingStrategy.executeWrite(program, "Import analysis options", () -> {
+            Options options = program.getOptions(Program.ANALYSIS_PROPERTIES);
+            for (Map.Entry<String, ?> e : requested.entrySet()) {
+                String name = e.getKey();
+                String value = String.valueOf(e.getValue());
+                if (!options.contains(name)) {
+                    throw new IllegalArgumentException("Unknown analysis option: " + name);
+                }
+                OptionType type = options.getType(name);
+                switch (type) {
+                    case BOOLEAN_TYPE -> options.setBoolean(name, Boolean.parseBoolean(value));
+                    case INT_TYPE -> options.setInt(name, Integer.parseInt(value));
+                    case LONG_TYPE -> options.setLong(name, Long.parseLong(value));
+                    case DOUBLE_TYPE -> options.setDouble(name, Double.parseDouble(value));
+                    case STRING_TYPE -> options.setString(name, value);
+                    default -> throw new IllegalArgumentException(
+                        "Analysis option " + name + " has type " + type + ", which import cannot set");
