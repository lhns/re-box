+package com.xebyte.offline;
+
+import com.xebyte.core.ImportRequest;
+import com.xebyte.core.ImportScripts;
+import com.xebyte.core.ProjectProgramProvider;
+import com.xebyte.core.SecurityConfig;
+import com.xebyte.headless.DirectThreadingStrategy;
+import ghidra.framework.model.DomainFile;
+import ghidra.framework.model.DomainFolder;
+import org.junit.Test;
+
+import java.io.File;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+/** /import_file's loader options, import scripts and multi-root file root. */
+public class ImportExtensionTest {
+
+    @Test
+    public void loaderArgsGetTheHeadlessPrefixOnce() {
+        Map<String, Object> raw = new LinkedHashMap<>();
+        raw.put("baseAddr", "1000:0100");
+        raw.put("-loader-applyLabels", true);
+        assertEquals(Map.of("-loader-baseAddr", "1000:0100", "-loader-applyLabels", "true"),
+            ImportRequest.normalizeLoaderArgs(raw));
+    }
+
+    @Test
+    public void requestDefaultsAndValidation() {
+        ImportRequest r = new ImportRequest(new File("/w/fw.bin"), " ", null, null, null, null, null, null, null);
+        assertEquals("/", r.folder());
+        assertEquals("fw.bin", r.programName());
+        assertEquals(ImportRequest.REUSE, r.ifExists());
+        assertTrue(r.preScripts().isEmpty());
+        assertThrows(IllegalArgumentException.class, () ->
+            new ImportRequest(new File("/w/x"), "/", null, "", null, "", "", "replace", null));
+        assertThrows(IllegalArgumentException.class, () ->
+            new ImportRequest(new File("/w/x"), "/", "a/b", "", null, "", "", null, null));
+    }
+
+    @Test
+    public void scriptListsParseWithArgsKeptWhole() {
+        List<ImportScripts.Call> calls = ImportScripts.parse(List.of(
+            Map.of("path", "/s/Prepare.java", "args", List.of("x86:LE:16:Real Mode", "1000:0100")),
+            Map.of("path", "/s/Fix.java")), "pre_scripts");
+        assertEquals(2, calls.size());
+        assertEquals(List.of("x86:LE:16:Real Mode", "1000:0100"), calls.get(0).args());
+        assertEquals(List.of(), calls.get(1).args());
+        assertThrows(IllegalArgumentException.class, () -> ImportScripts.parse("x", "pre_scripts"));
+        assertThrows(IllegalArgumentException.class, () ->
+            ImportScripts.parse(List.of(Map.of("args", List.of())), "pre_scripts"));
+    }
+
+    @Test
+    public void severalFileRootsAndPrefixSafety() {
+        List<Path> roots = SecurityConfig.canonicalRoots("/work" + File.pathSeparator + " " + File.pathSeparator + "/tmp/rea");
+        assertEquals(2, roots.size());
+        assertTrue(SecurityConfig.underAny(Path.of("/tmp/rea/x/target.bin"), roots));
+        assertTrue(SecurityConfig.underAny(Path.of("/work/a"), roots));
+        assertFalse(SecurityConfig.underAny(Path.of("/workshop/a"), roots));
+        assertTrue(SecurityConfig.canonicalRoots(null).isEmpty());
+    }
+
+    @Test
+    public void uniqueNamesCountUp() {
+        DomainFolder folder = mock(DomainFolder.class);
+        when(folder.getFile("fw.bin.1")).thenReturn(mock(DomainFile.class));
+        assertEquals("fw.bin.2", ProjectProgramProvider.uniqueName(folder, "fw.bin"));
+    }
+
+    @Test
+    public void theWriteLockIsOnePerJvm() {
+        assertSame(DirectThreadingStrategy.writeLock(), DirectThreadingStrategy.writeLock());
+        new DirectThreadingStrategy();
+        assertFalse(DirectThreadingStrategy.writeLock().isLocked());
+    }
+}
