re-box patch 0002: /import_file takes AnalyzeHeadless's import options; one write lock per JVM.

- /import_file: loader ("", "auto" or a loader class), loader_args (-loader-<name>), program_name,
  analysis_options, pre_scripts / post_scripts ([{path, args}], run like -preScript/-postScript;
  gated by GHIDRA_MCP_ALLOW_SCRIPTS and GHIDRA_MCP_IMPORT_SCRIPT_ROOTS), if_exists
  (reuse only the same bytes / error / unique), wait (false: analysis and post-scripts in the
  background, reported by /analysis_status). ProgramLoader replaces AutoImporter.
- GHIDRA_MCP_FILE_ROOT takes several roots (path-separator list).
- Script loads are serialized JVM-wide (ImportScripts.LOAD_LOCK): Ghidra's bundle-build file lock
  throws OverlappingFileLockException for two threads of one JVM.
- DirectThreadingStrategy's lock is one per JVM, exposed as writeLock() for code running in the
  server's JVM (re-box: REA's bridge, ReboxReaAttach.java).
- Bridge: import_file exposes the new parameters; its timeout is 1800 s.

Upstream versions, split by concern and against dev: deps/ghidra-mcp/upstream/.

diff -ruN a/src/main/java/com/xebyte/core/ImportRequest.java b/src/main/java/com/xebyte/core/ImportRequest.java
--- a/src/main/java/com/xebyte/core/ImportRequest.java
+++ b/src/main/java/com/xebyte/core/ImportRequest.java
@@ -0,0 +1,80 @@
+package com.xebyte.core;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * What {@code /import_file} imports and how: the loader options AnalyzeHeadless takes
+ * ({@code -loader}, {@code -loader-<name>}, {@code -processor}, {@code -cspec}), the name of
+ * the new program, and the scripts that run on it before it is first saved.
+ *
+ * @param file           the file to import
+ * @param folder         project folder; "/" when blank
+ * @param programName    name of the new program; the file name when blank
+ * @param loader         "" = auto-detect, or BinaryLoader when a language is given (the
+ *                       endpoint's original behaviour); "auto" = auto-detect with language and
+ *                       compiler spec as hints; otherwise a loader class name (BinaryLoader,
+ *                       MzLoader, ElfLoader, ...)
+ * @param loaderArgs     loader options by name, with or without the "-loader-" prefix
+ *                       (BinaryLoader's base address is "baseAddr")
+ * @param languageId     language ID or ""
+ * @param compilerSpecId compiler spec ID or ""
+ * @param ifExists       what to do when the folder already holds a program of that name:
+ *                       "reuse" it when it was imported from the same bytes (else fail),
+ *                       "error", or import under a "unique" name
+ * @param preScripts     scripts run on the loaded program before it is saved and analyzed
+ */
+public record ImportRequest(File file, String folder, String programName, String loader,
+        Map<String, String> loaderArgs, String languageId, String compilerSpecId,
+        String ifExists, List<ImportScripts.Call> preScripts) {
+
+    public static final String REUSE = "reuse";
+    public static final String ERROR = "error";
+    public static final String UNIQUE = "unique";
+
+    public ImportRequest {
+        folder = folder == null || folder.isBlank() ? "/" : folder.trim();
+        programName = programName == null || programName.isBlank() ? file.getName() : programName.trim();
+        loader = loader == null ? "" : loader.trim();
+        loaderArgs = loaderArgs == null ? Map.of() : normalizeLoaderArgs(loaderArgs);
+        languageId = languageId == null ? "" : languageId.trim();
+        compilerSpecId = compilerSpecId == null ? "" : compilerSpecId.trim();
+        ifExists = ifExists == null || ifExists.isBlank() ? REUSE : ifExists.trim().toLowerCase(Locale.ROOT);
+        if (!List.of(REUSE, ERROR, UNIQUE).contains(ifExists)) {
+            throw new IllegalArgumentException("if_exists must be reuse, error or unique");
+        }
+        if (programName.contains("/")) {
+            throw new IllegalArgumentException("program_name must not contain '/'");
+        }
+        preScripts = preScripts == null ? List.of() : List.copyOf(preScripts);
+    }
+
+    /** The original four-argument import: auto-detect, or BinaryLoader with a language. */
+    public static ImportRequest basic(File file, String folder, String languageId, String compilerSpecId) {
+        return new ImportRequest(file, folder, null, "", null, languageId, compilerSpecId, REUSE, null);
+    }
+
+    /** Keys as AnalyzeHeadless passes them to the loader: "-loader-<name>". */
+    public static Map<String, String> normalizeLoaderArgs(Map<String, ?> raw) {
+        Map<String, String> out = new LinkedHashMap<>();
+        for (Map.Entry<String, ?> e : raw.entrySet()) {
+            String key = e.getKey() == null ? "" : e.getKey().trim();
+            if (key.isEmpty()) {
+                throw new IllegalArgumentException("loader_args has an empty name");
+            }
+            out.put(key.startsWith("-loader-") ? key : "-loader-" + key,
+                e.getValue() == null ? "" : String.valueOf(e.getValue()));
+        }
+        return out;
+    }
+
+    List<generic.stl.Pair<String, String>> loaderArgPairs() {
+        List<generic.stl.Pair<String, String>> pairs = new ArrayList<>();
+        loaderArgs.forEach((k, v) -> pairs.add(new generic.stl.Pair<>(k, v)));
+        return pairs;
+    }
+}
diff -ruN a/src/main/java/com/xebyte/core/ImportScripts.java b/src/main/java/com/xebyte/core/ImportScripts.java
--- a/src/main/java/com/xebyte/core/ImportScripts.java
+++ b/src/main/java/com/xebyte/core/ImportScripts.java
@@ -0,0 +1,138 @@
+package com.xebyte.core;
+
+import generic.jar.ResourceFile;
+import ghidra.app.script.GhidraScript;
+import ghidra.app.script.GhidraScriptProvider;
+import ghidra.app.script.GhidraScriptUtil;
+import ghidra.app.script.GhidraState;
+import ghidra.app.script.ScriptControls;
+import ghidra.framework.model.Project;
+import ghidra.program.model.listing.Program;
+import ghidra.program.util.ProgramLocation;
+import ghidra.util.task.TaskMonitor;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Scripts that run as part of an import, as AnalyzeHeadless's {@code -preScript} and
+ * {@code -postScript} do: on the loaded program before its first save and analysis, or after
+ * analysis.
+ *
+ * <p>Each script's directory is enabled as its own OSGi source bundle (a directory may ship
+ * its own bundle activator), not copied into {@code ~/ghidra_scripts}. Loading is serialized
+ * through {@link #LOAD_LOCK}: Ghidra guards bundle builds with a file lock meant for separate
+ * JVMs, so two threads of one JVM building at once fail with OverlappingFileLockException.
+ *
+ * <p>Gated by {@code GHIDRA_MCP_ALLOW_SCRIPTS}; with {@code GHIDRA_MCP_IMPORT_SCRIPT_ROOTS}
+ * set, a script must also lie under one of those directories.
+ */
+public final class ImportScripts {
+
+    /** Held while a script bundle is built and its class loaded; see the class comment. */
+    public static final Object LOAD_LOCK = new Object();
+
+    /** One script and its arguments; arguments are passed as given, never split. */
+    public record Call(String path, List<String> args) {
+        public Call {
+            if (path == null || path.isBlank()) {
+                throw new IllegalArgumentException("a script needs a path");
+            }
+            args = args == null ? List.of() : List.copyOf(args);
+        }
+    }
+
+    private ImportScripts() {}
+
+    /**
+     * Parse {@code [{"path": "...", "args": ["...", ...]}, ...]} as the endpoint receives it
+     * (a list of maps; args may also be one string, taken as a single argument).
+     */
+    public static List<Call> parse(Object raw, String what) {
+        if (raw == null) {
+            return List.of();
+        }
+        if (!(raw instanceof List<?> list)) {
+            throw new IllegalArgumentException(what + " must be a list of {path, args}");
+        }
+        List<Call> calls = new ArrayList<>();
+        for (Object item : list) {
+            if (!(item instanceof Map<?, ?> map) || map.get("path") == null) {
+                throw new IllegalArgumentException(what + " entries need a path");
+            }
+            Object rawArgs = map.get("args");
+            List<String> args = new ArrayList<>();
+            if (rawArgs instanceof List<?> argList) {
+                for (Object a : argList) {
+                    args.add(String.valueOf(a));
+                }
+            } else if (rawArgs != null) {
+                args.add(String.valueOf(rawArgs));
+            }
+            calls.add(new Call(String.valueOf(map.get("path")), args));
+        }
+        return calls;
+    }
+
+    /** Refuse scripts when they are not allowed, or lie outside the configured roots. */
+    public static void check(List<Call> calls) throws IOException {
+        if (calls.isEmpty()) {
+            return;
+        }
+        SecurityConfig security = SecurityConfig.getInstance();
+        if (!security.areScriptsAllowed()) {
+            throw new IOException("Import scripts need GHIDRA_MCP_ALLOW_SCRIPTS=1");
+        }
+        for (Call call : calls) {
+            File file = new File(call.path());
+            if (!file.isAbsolute() || !file.isFile() || !file.getName().endsWith(".java")) {
+                throw new IOException("Import script is not an absolute path to a .java file: " + call.path());
+            }
+            Path canonical = file.getCanonicalFile().toPath();
+            if (!security.isImportScriptAllowed(canonical)) {
+                throw new IOException("Import script outside GHIDRA_MCP_IMPORT_SCRIPT_ROOTS: " + call.path());
+            }
+        }
+    }
+
+    /** Run each script on {@code program}, in order; the first failure stops the run. */
+    public static void run(List<Call> calls, Program program, Project project, PrintWriter out,
+            TaskMonitor monitor) throws Exception {
+        for (Call call : calls) {
+            monitor.checkCancelled();
+            GhidraScript script = load(new File(call.path()), out);
+            script.setScriptArgs(call.args().toArray(String[]::new));
+            ProgramLocation where = program.getMinAddress() == null ? null
+                : new ProgramLocation(program, program.getMinAddress());
+            out.println("--- " + new File(call.path()).getName() + " " + call.args());
+            script.execute(new GhidraState(null, project, program, where, null, null),
+                new ScriptControls(out, out, monitor));
+        }
+    }
+
+    /** A fresh instance of the script at {@code file}, its directory enabled as a bundle. */
+    public static GhidraScript load(File file, PrintWriter out) throws Exception {
+        ResourceFile source = new ResourceFile(file.getCanonicalFile());
+        synchronized (LOAD_LOCK) {
+            if (GhidraScriptUtil.getBundleHost() == null) {
+                // Headless: no script manager plugin owns the bundle host.
+                GhidraScriptUtil.acquireBundleHostReference();
+            }
+            GhidraScriptUtil.getBundleHost().enable(source.getParentFile());
+            GhidraScriptProvider provider = GhidraScriptUtil.getProvider(source);
+            if (provider == null) {
+                throw new IOException("No script provider for " + file);
+            }
+            GhidraScript script = provider.getScriptInstance(source, out);
+            if (script == null) {
+                throw new IOException("Could not load " + file);
+            }
+            return script;
+        }
+    }
+}
