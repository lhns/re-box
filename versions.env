# Single source of the pins the build downloads. Each RUN that needs a pin bind-mounts this
# file (via the `pins` stage), so plain `docker build` works without --build-arg.
# Base images (ubuntu, uv) are pinned tag@digest in the Dockerfile's FROM lines: a FROM cannot
# read a file. Package trees are locked separately: aggregator/uv.lock, deps/rea/package-lock.json,
# deps/tools/requirements.txt.
#
# Renovate bumps the version lines (renovate.json, regex manager); it cannot refresh the
# *_SHA256 lines, so run `python3 scripts/check-pins.py --update` after a bump (CI runs it
# without --update and fails on a stale digest).

# renovate: datasource=github-releases depName=NationalSecurityAgency/ghidra extractVersion=^Ghidra_(?<version>.+)_build$
GHIDRA_VERSION=12.1.4
GHIDRA_RELEASE_DATE=20260921
GHIDRA_SHA256=ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db

# Tags are mutable, so the build checks out GHIDRA_MCP_COMMIT and verifies the tag points at it.
# renovate: datasource=github-tags depName=bethington/ghidra-mcp
GHIDRA_MCP_REF=v7.0.0-rc.3
GHIDRA_MCP_COMMIT=295e3adbafba44aa385e62c6733b3588762a7c9e

# Must equal the rea-agents version in deps/rea/package.json (the build checks it).
# renovate: datasource=npm depName=rea-agents
REA_VERSION=6.7.0

# renovate: datasource=node-version depName=node
NODE_VERSION=24.22.0
NODE_SHA256=cc2f601cee82d9a5a233302fe307abc600727035fd7d2c3a3571755989e95008

# Full JDK: REA's Ghidra provider and Ghidra's script loader need javac.
# renovate: datasource=github-releases depName=adoptium/temurin21-binaries extractVersion=^jdk-(?<version>.+)$
JDK_VERSION=21.0.12.1+1
JDK_SHA256=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94

# Builds the ghidra-mcp jar; ghidra-mcp's wrapper fetches it unverified, so we fetch it ourselves.
# renovate: datasource=gradle-version depName=gradle
GRADLE_VERSION=9.8.0
GRADLE_SHA256=bafd5ce9cfaea0fbccfdc8439a1ac42fbd4cd9c89dc9a988228d8a2639a58e6c
