# Single source of the pins the build downloads. Each RUN that needs a pin bind-mounts this
# file (via the `pins` stage), so plain `docker build` works without --build-arg.
# Base images (ubuntu, uv) are pinned tag@digest in the Dockerfile's FROM lines: a FROM cannot
# read a file. Package trees are locked separately: aggregator/uv.lock, deps/rea/package-lock.json,
# deps/tools/requirements-*.txt (the tools and pwndbg's build backends), deps/build/requirements-*.txt
# (the aggregator's and the bridge's build backend). Regenerate: docs/BUILDING.md.
#
# Each download is <X>_VERSION, <X>_URL (sh-expanded from the version), <X>_SHA256. Renovate
# bumps the version lines (renovate.json, regex manager); it cannot refresh the digests, so run
# `python3 scripts/check-pins.py --update` after a bump. CI runs it without --update and fails on
# a stale digest.

# Every apt step reads this snapshot of the Ubuntu archive (snapshot.ubuntu.com), so a rebuild gets
# the same packages. No Renovate datasource: move it by hand to a recent date and run the test stage.
APT_SNAPSHOT=20261017T000000Z

# renovate: datasource=github-releases depName=NationalSecurityAgency/ghidra extractVersion=^Ghidra_(?<version>.+)_build$
GHIDRA_VERSION=12.1.4
GHIDRA_RELEASE_DATE=20260921
GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_RELEASE_DATE}.zip
GHIDRA_SHA256=ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db

# Tags are mutable, so the build checks out GHIDRA_MCP_COMMIT and verifies the tag points at it.
# renovate: datasource=github-tags depName=bethington/ghidra-mcp
GHIDRA_MCP_REF=v7.0.0-rc.3
GHIDRA_MCP_COMMIT=295e3adbafba44aa385e62c6733b3588762a7c9e

# Must equal the rea-agents version in deps/rea/package.json (the build checks it).
# renovate: datasource=npm depName=rea-agents
REA_VERSION=6.7.0

# renovate: datasource=node-version depName=node
NODE_VERSION=24.22.0
NODE_URL=https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz
NODE_SHA256=cc2f601cee82d9a5a233302fe307abc600727035fd7d2c3a3571755989e95008

# Full JDK: REA's Ghidra provider and Ghidra's script loader need javac.
# renovate: datasource=github-releases depName=adoptium/temurin21-binaries extractVersion=^jdk-(?<version>.+)$
JDK_VERSION=21.0.12.1+1
JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-${JDK_VERSION}/OpenJDK21U-jdk_x64_linux_hotspot_${JDK_VERSION%+*}_${JDK_VERSION#*+}.tar.gz
JDK_SHA256=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94

# Builds the ghidra-mcp jar; ghidra-mcp's wrapper fetches it unverified, so we fetch it ourselves.
# renovate: datasource=gradle-version depName=gradle
GRADLE_VERSION=9.8.0
GRADLE_URL=https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip
GRADLE_SHA256=bafd5ce9cfaea0fbccfdc8439a1ac42fbd4cd9c89dc9a988228d8a2639a58e6c

# --- Analysis tools (deps/tools/install-tools.sh). Versions are the ones REA 6.7.0 expects or was
# verified with; third_party/*/README.md and docs/ in rea-agents say which. Python tools are locked
# in deps/tools/requirements-*.txt, apt packages come from the signed Ubuntu archive.

# renovate: datasource=github-releases depName=WebAssembly/wabt
TOOL_WABT_VERSION=1.0.42
TOOL_WABT_URL=https://github.com/WebAssembly/wabt/releases/download/${TOOL_WABT_VERSION}/wabt-${TOOL_WABT_VERSION}-linux-x64.tar.gz
TOOL_WABT_SHA256=84895407a6bbb80e918f33b16b2fb2206021c150b6bc9ff6f761263a745ab131

# renovate: datasource=github-releases depName=rizinorg/rizin extractVersion=^v(?<version>.+)$
TOOL_RIZIN_VERSION=0.9.1
TOOL_RIZIN_URL=https://github.com/rizinorg/rizin/releases/download/v${TOOL_RIZIN_VERSION}/rizin-v${TOOL_RIZIN_VERSION}-static-x86_64.tar.xz
TOOL_RIZIN_SHA256=9102249a9f0b6319c5334a2e5cf8d9cc3f2035e1d3def027c41f6a90f647e8cf

# Pinned 2.x: Apktool before 2.9.2 and 3.0.0 to 3.0.1 have path-traversal advisories (Ubuntu ships 2.7.0).
# renovate: datasource=github-releases depName=iBotPeaches/Apktool extractVersion=^v(?<version>.+)$
TOOL_APKTOOL_VERSION=2.12.1
TOOL_APKTOOL_URL=https://github.com/iBotPeaches/Apktool/releases/download/v${TOOL_APKTOOL_VERSION}/apktool_${TOOL_APKTOOL_VERSION}.jar
TOOL_APKTOOL_SHA256=66cf4524a4a45a7f56567d08b2c9b6ec237bcdd78cee69fd4a59c8a0243aeafa

# The exact JAR REA audits (src/android/JadxRelease.ts); REA refuses to attribute other bytes to it.
# renovate: datasource=github-releases depName=1013503897/jadx-headless-mcp extractVersion=^v(?<version>.+)$
TOOL_JADX_MCP_VERSION=0.7.1
TOOL_JADX_MCP_URL=https://github.com/1013503897/jadx-headless-mcp/releases/download/v${TOOL_JADX_MCP_VERSION}/jadx-headless-mcp-${TOOL_JADX_MCP_VERSION}-all.jar
TOOL_JADX_MCP_SHA256=6e5eacf500b64292bfb73c49797c1958f6ee44646e43e868039ae7feb573ff75

# REA's http3 lab verifies mitmdump 12.2.3 and requires exactly that.
# renovate: datasource=github-releases depName=mitmproxy/mitmproxy extractVersion=^v(?<version>.+)$
TOOL_MITMPROXY_VERSION=12.2.3
TOOL_MITMPROXY_URL=https://downloads.mitmproxy.org/${TOOL_MITMPROXY_VERSION}/mitmproxy-${TOOL_MITMPROXY_VERSION}-linux-x86_64.tar.gz
TOOL_MITMPROXY_SHA256=2e95286b618fa6fd33e5e62a78c2e5112571d85f42ec2bac29b97ee242bdb5c5

# Binwalk 3.x ships no binaries and Ubuntu has 2.3.4: built from source at the tag's commit.
# renovate: datasource=github-tags depName=ReFirmLabs/binwalk
TOOL_BINWALK_REF=v3.1.0
TOOL_BINWALK_COMMIT=4fdab3d464d97b68e0af9088df3f9e2e1545b21c

# pwndbg installs from its git checkout with its own frozen uv.lock; REA verifies this exact commit.
# renovate: datasource=github-tags depName=pwndbg/pwndbg
TOOL_PWNDBG_REF=2026.09.15
TOOL_PWNDBG_COMMIT=55596aa676a2756efb8d67034f31675170eabe48

# Chrome for Testing (Ubuntu's chromium is a snap). The digest is of chrome-linux64.zip, taken
# when pinning: the project publishes none. Needs a customDatasources entry in renovate.json
# reading channels.Stable.version from
# https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions.json
# renovate: datasource=custom.chrome-for-testing depName=chrome-for-testing
TOOL_CHROME_VERSION=155.0.8059.84
TOOL_CHROME_URL=https://storage.googleapis.com/chrome-for-testing-public/${TOOL_CHROME_VERSION}/linux64/chrome-linux64.zip
TOOL_CHROME_SHA256=cf0f049892dea22e6a6db26d47ed0d7776b7158edcbec4634086633df8bafcbc
